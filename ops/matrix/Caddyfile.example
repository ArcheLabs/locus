# Public HTTPS routes for rpc-stage1.minijam.xyz.
# The application RPC and Matrix resolver are the only routes on this host.
rpc-stage1.minijam.xyz {
	@rpc path /rpc /rpc/*
	handle @rpc {
		reverse_proxy 127.0.0.1:8090
	}

	handle_path /matrix-resolver/* {
		reverse_proxy 127.0.0.1:8787
	}

	respond 404
}

# Matrix federation and public server keys only. The Client-Server API at
# 127.0.0.1:8008 remains private.
matrix.minijam.xyz {
	@server_well_known path /.well-known/matrix/server
	handle @server_well_known {
		header Content-Type application/json
		respond `{"m.server":"matrix.minijam.xyz:443"}` 200
	}

	@federation path /_matrix/federation/*
	handle @federation {
		reverse_proxy 127.0.0.1:8008
	}

	@server_keys path /_matrix/key/*
	handle @server_keys {
		reverse_proxy 127.0.0.1:8008
	}

	respond 404
}
